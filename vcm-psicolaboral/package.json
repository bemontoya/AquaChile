{
  "name": "vcm-psicolaboral",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "postinstall": "prisma skills sync || exit 0",
    "test:backend": "cross-env NODE_ENV=test vitest run tests/backend.test.js --environment node --coverage --coverage.include=server.js --coverage.include=middlewares/**",
    "test:frontend": "vitest run tests/frontend.test.jsx src/components --environment jsdom --coverage --coverage.include=src/components/** --coverage.include=src/utils/**",
    "test:all": "npm run test:backend && npm run test:frontend"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "prisma": "5.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "resend": "^6.37.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^22.1.0",
    "supertest": "^7.3.2",
    "vite": "^4.0.0",
    "vitest": "^2.1.9"
  }
}
